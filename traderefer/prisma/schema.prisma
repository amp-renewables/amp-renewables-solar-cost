// TradeRefer database schema.
//
// MULTI-TENANT SaaS model:
//   - The platform (TradeRefer) hosts many `Company` rows.
//   - Each Company pays £99/month (or is "comped" — e.g. AMP Renewables).
//   - Each Company has its own /<slug> landing page, its own branding,
//     its own referrer partners, and its own referrals/payouts/templates.
//   - SUPERADMIN users (the platform operators, e.g. Joe) can see all.
//   - COMPANY_ADMIN users own one company and see only that company's data.
//   - PARTNER users (the referring tradesmen) belong to one company.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// DEPRECATED — superseded by Membership.role + User.isSuperadmin.
// Still present because the User.role column hasn't been dropped yet
// (kept through the multi-org migration so a half-deployed build can't
// crash on a missing column). Nothing should READ this anymore.
enum Role {
  SUPERADMIN     // TradeRefer platform admin
  COMPANY_ADMIN  // Owns/runs a Company that pays £99/mo
  PARTNER        // Refers customers under a Company
}

// What a user IS at a given company. A user can hold one membership per
// company, and memberships at any number of companies — that's the whole
// point of the multi-org model. "Sarah refers to AMP as Smith Roofing
// and to a Manchester installer as herself" is two Membership rows on
// one User.
enum MembershipRole {
  COMPANY_ADMIN    // runs the company's programme
  BUSINESS_PARTNER // a trade business referring customers (full payout rates)
  AMBASSADOR       // an individual — past customer, friend (ambassador rates)
}

enum CompanyStatus {
  TRIAL          // 14-day free trial, no charge yet
  ACTIVE         // Paying / comped
  PAST_DUE       // Last invoice failed — grace period
  CANCELLED      // No longer billed; read-only access
}

enum ReferralStatus {
  SUBMITTED
  CONTACTED
  APPOINTMENT_BOOKED
  APPOINTMENT_COMPLETED
  JOB_SOLD
  JOB_INSTALLED
  REJECTED
}

enum PayoutType {
  APPOINTMENT
  JOB
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum Channel {
  SMS
  EMAIL
}

enum InviteStatus {
  PENDING   // added to the list, not yet sent
  SENT      // delivered to the SMS/email provider successfully
  FAILED    // provider rejected it (bad number, bounce, etc)
  SIGNED_UP // recipient followed their invite link and created an account
}

// A paying customer of the TradeRefer platform.
// Their landing page lives at /<slug> (e.g. /amprenewables).
model Company {
  id   String @id @default(cuid())
  slug String @unique // /amprenewables, /joes-solar

  // Public identity
  name        String
  contactEmail String  // billing + admin contact
  contactPhone String?
  websiteUrl  String?
  addressLine String?  // displayed in footer

  // Branding
  logoUrl       String?
  // Light/inverse logo for use on dark backgrounds (signup landing left
  // panel, admin nav, partner nav). If null, those surfaces fall back to
  // rendering the company name as text in the brand-accent colour.
  logoUrlLight  String?
  // Defaults match the TradeRefer platform brand (slate + amber). New
  // tenants land with a neutral on-brand look until they customise via
  // /company/settings. AMP Renewables (the original tenant) explicitly
  // stored its own green values so it's unaffected by changes here.
  primaryColor  String @default("#1e293b")
  accentColor   String @default("#f59e0b")
  heroSubheading String? // optional one-liner used on /<slug>

  // Optional custom signature text — the one-liner that appears at the
  // bottom of every email the company sends, prompting recipients to
  // sign up as a referral partner. Supports {{payoutTotal}}, {{signupUrl}},
  // {{companyName}} placeholders. If null, a sensible default is used —
  // see lib/signature.ts.
  emailSignature     String?

  // Programme config (per-company versions of the old env-var settings)
  services           String[] // ["Solar PV", "Battery Storage", ...]
  payoutAppointment  Decimal  @db.Decimal(10, 2) @default(50)
  payoutJob          Decimal  @db.Decimal(10, 2) @default(250)
  currencySymbol     String   @default("£")

  // Which referrer types the public /<slug>/signup page accepts. Both on
  // by default — a company that only wants trade businesses (or only
  // past-customer ambassadors) can switch one off in settings. The
  // signup action validates against these server-side, so a crafted POST
  // can't create a disallowed membership type.
  acceptsBusinessPartners Boolean @default(true)
  acceptsAmbassadors      Boolean @default(true)

  // Ambassador payout rates — deliberately separate from (and defaulting
  // lower than) the business-partner rates above. An ambassador is a
  // past customer or friend referring occasionally, not a tradesman with
  // a pipeline; companies typically pay them less per referral.
  ambassadorPayoutAppointment Decimal @db.Decimal(10, 2) @default(25)
  ambassadorPayoutJob         Decimal @db.Decimal(10, 2) @default(100)

  // Subscription / status
  status             CompanyStatus @default(TRIAL)
  isComped           Boolean       @default(false) // never billed (e.g. AMP)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // ─── Internal referral programme ──────────────────────────────
  // Who referred this company to TradeRefer (set at signup via
  // ?ref=<slug>). Null if they came in cold. Self-relation; deleting
  // the referrer doesn't cascade — we just null out this link so the
  // referred company stays intact with no upstream credit.
  referredByCompanyId String?
  referredBy          Company?  @relation("CompanyReferrals", fields: [referredByCompanyId], references: [id], onDelete: SetNull)
  referredCompanies   Company[] @relation("CompanyReferrals")

  // Timestamp of the FIRST successful invoice payment. Stays null
  // through TRIAL, set the moment Stripe fires invoice.payment_succeeded
  // for the first time. This is the gate that activates the referrer's
  // 25% discount slice — we don't credit referrers for trial-only
  // signups, only for ones that converted to paid.
  referralQualifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  memberships    Membership[]
  referrals      Referral[]
  templates      MessageTemplate[]
  partnerInvites PartnerInvite[]

  @@index([status])
  @@index([referredByCompanyId])
}

// The join between a User and a Company — what the old User.role +
// User.companyId pair encoded, but many-per-user. Access control reads
// the session's ACTIVE membership (Session.activeMembershipId); the org
// switcher in the nav changes which one that is.
//
// Deleting a company cascades its memberships. Deleting a user cascades
// their memberships (referrals are the durable record, and they hang off
// User/Company directly).
model Membership {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      MembershipRole

  createdAt DateTime @default(now())

  sessions Session[]

  @@unique([userId, companyId]) // one hat per company
  @@index([companyId, role])
  @@index([userId])
}

// A contact a company has invited to become a referral partner — by SMS
// or email, in bulk from /company/invites. Each invite carries a unique
// token baked into its signup link so we can attribute conversions
// ("which of the 50 roofers I texted actually signed up?").
//
// PRIVACY: these are contacts the company asserts a business
// relationship with (confirmed by checkbox at send time). We store the
// minimum needed to send + display status. No marketing reuse — the
// platform never contacts these people for its own purposes.
model PartnerInvite {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String?
  phone String? // E.164-ish, required for SMS channel
  email String? // required for EMAIL channel

  channel Channel
  status  InviteStatus @default(PENDING)

  // Unguessable token embedded in the invite link
  // (/<slug>/signup?invite=<token>). Marks the invite SIGNED_UP when a
  // partner account is created through it.
  token String @unique

  // What was actually sent, post-placeholder-interpolation. Kept for
  // audit ("what did we text this person?") and debugging.
  sentMessage String?
  sentAt      DateTime?
  failReason  String?

  signedUpAt     DateTime?
  signedUpUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  hashedPassword String

  // Platform operator flag (Joe). Orthogonal to memberships — a
  // superadmin can also hold company memberships and switch between
  // "Platform" and company contexts in the nav.
  isSuperadmin Boolean @default(false)

  // DEPRECATED — replaced by Membership rows + isSuperadmin. Columns kept
  // (unread) until a post-migration cleanup drops them. Don't write to
  // these; defaults satisfy inserts.
  role      Role     @default(PARTNER)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Profile (used by COMPANY_ADMIN and PARTNER)
  fullName     String?
  phone        String?
  businessName String?

  // Bank details for partner payouts (PARTNER only). Captured in dashboard
  // settings rather than at signup so it doesn't slow the signup flow.
  //
  // The sort code and account number are encrypted at the application layer
  // (AES-256-GCM with BANK_ENCRYPTION_KEY, see src/lib/crypto.ts) — what's
  // stored here is a base64-encoded envelope, not the raw number. The Last2
  // / Last4 columns store the trailing digits in plaintext so masked admin
  // views can render "**-**-67 · **** 4321" without paying a decrypt per
  // row. Last digits alone don't identify an account.
  bankAccountName        String?
  bankSortCode           String?  // encrypted envelope
  bankAccountNumber      String?  // encrypted envelope
  bankSortCodeLast2      String?  // plaintext, for masked display
  bankAccountNumberLast4 String?  // plaintext, for masked display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  referrals          Referral[]
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  bankDetailsViewed  BankDetailsAccess[] @relation("PartnerBankAccess")
  bankDetailsViews   BankDetailsAccess[] @relation("AdminBankAccess")

  @@index([companyId])
  @@index([role])
}

// Append-only audit log: every time a company admin reveals a partner's
// full bank details from the masked UI, we record it here. Lets us answer
// "who has seen my bank details?" for GDPR subject-access requests and
// detect insider abuse. Never deleted — partner-driven account anonymisation
// nulls fields rather than removing rows.
model BankDetailsAccess {
  id              String   @id @default(cuid())
  partnerUserId   String
  partner         User     @relation("PartnerBankAccess", fields: [partnerUserId], references: [id], onDelete: Cascade)
  viewedByUserId  String
  viewedBy        User     @relation("AdminBankAccess", fields: [viewedByUserId], references: [id], onDelete: Cascade)
  viewedAt        DateTime @default(now())
  // Free-form context for diagnostics, e.g. "payouts page", "partner detail".
  context         String?

  @@index([partnerUserId, viewedAt])
  @@index([viewedByUserId, viewedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Which of the user's memberships this session is currently acting as
  // (the "active hat"). Null means no company context — either a
  // superadmin in Platform view, or a stale/pre-migration session, which
  // getSessionUser self-heals by adopting the user's first membership.
  // SetNull (not Cascade): losing a membership must not log you out.
  activeMembershipId String?
  activeMembership   Membership? @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

// Single-use tokens for "forgot password" flow.
// The DB stores a SHA-256 hash of the token, never the raw value; the raw
// token is only ever in the link emailed to the user. Tokens expire after
// 1 hour and are marked used the moment they're consumed.
model PasswordResetToken {
  id          String    @id @default(cuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Referral {
  id        String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  partnerId String
  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  // Only name + phone + postcode are required. A tradesman in a van has
  // the customer's number and roughly where they live — email and full
  // address are luxuries the company can collect on the follow-up call.
  // Requiring them was friction that killed mobile submissions.
  customerName  String
  customerPhone String
  customerEmail String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  postcode     String

  services String[]
  notes    String?

  // GDPR / data-protection record. The partner ticks a box on the refer
  // form confirming they have the customer's permission to share their
  // details with the receiving company. customerConsentConfirmedAt is set
  // server-side at submission so we have an auditable timestamp; the
  // boolean is kept for fast filtering. Existing rows pre-dating this
  // field default to false — meaning we explicitly don't claim consent
  // we didn't capture.
  customerConsentConfirmed   Boolean   @default(false)
  customerConsentConfirmedAt DateTime?

  status ReferralStatus @default(SUBMITTED)

  // Soft-archive. Hidden from default /company/referrals view but kept in
  // the DB (and still visible from /company/payouts if there's money
  // owed). Restored by setting back to null. Orthogonal to the status
  // enum — a REJECTED referral is one the customer walked away from; an
  // ARCHIVED referral is one the admin no longer wants in their face.
  archivedAt DateTime?

  appointmentBookedAt    DateTime?
  appointmentDate        DateTime?
  appointmentCompletedAt DateTime?
  jobSoldAt              DateTime?
  jobInstalledAt         DateTime?
  jobValue               Decimal?  @db.Decimal(10, 2)
  rejectedReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts       Payout[]
  statusHistory ReferralStatusEvent[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, archivedAt])
  @@index([partnerId])
}

model ReferralStatusEvent {
  id              String          @id @default(cuid())
  referralId      String
  referral        Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  fromStatus      ReferralStatus?
  toStatus        ReferralStatus
  changedBy       String?
  note            String?
  createdAt       DateTime        @default(now())

  @@index([referralId])
}

model Payout {
  id         String       @id @default(cuid())
  referralId String
  referral   Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  type       PayoutType
  amount     Decimal      @db.Decimal(10, 2)
  status     PayoutStatus @default(PENDING)
  paidAt     DateTime?
  paidBy     String?
  paymentRef String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralId])
  @@index([status])
}

model MessageTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel   Channel
  title     String
  subject   String?
  body      String  @db.Text
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, channel, active, sortOrder])
}
