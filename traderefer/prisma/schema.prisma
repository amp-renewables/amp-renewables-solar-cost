// TradeRefer database schema.
//
// MULTI-TENANT SaaS model:
//   - The platform (TradeRefer) hosts many `Company` rows.
//   - Each Company pays £99/month (or is "comped" — e.g. AMP Renewables).
//   - Each Company has its own /<slug> landing page, its own branding,
//     its own referrer partners, and its own referrals/payouts/templates.
//   - SUPERADMIN users (the platform operators, e.g. Joe) can see all.
//   - COMPANY_ADMIN users own one company and see only that company's data.
//   - PARTNER users (the referring tradesmen) belong to one company.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN     // TradeRefer platform admin
  COMPANY_ADMIN  // Owns/runs a Company that pays £99/mo
  PARTNER        // Refers customers under a Company
}

enum CompanyStatus {
  TRIAL          // 14-day free trial, no charge yet
  ACTIVE         // Paying / comped
  PAST_DUE       // Last invoice failed — grace period
  CANCELLED      // No longer billed; read-only access
}

enum ReferralStatus {
  SUBMITTED
  CONTACTED
  APPOINTMENT_BOOKED
  APPOINTMENT_COMPLETED
  JOB_SOLD
  JOB_INSTALLED
  REJECTED
}

enum PayoutType {
  APPOINTMENT
  JOB
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum Channel {
  SMS
  EMAIL
}

// A paying customer of the TradeRefer platform.
// Their landing page lives at /<slug> (e.g. /amprenewables).
model Company {
  id   String @id @default(cuid())
  slug String @unique // /amprenewables, /joes-solar

  // Public identity
  name        String
  contactEmail String  // billing + admin contact
  contactPhone String?
  websiteUrl  String?
  addressLine String?  // displayed in footer

  // Branding
  logoUrl       String?
  primaryColor  String @default("#1a3c2a")
  accentColor   String @default("#52b788")
  heroSubheading String? // optional one-liner used on /<slug>

  // Programme config (per-company versions of the old env-var settings)
  services           String[] // ["Solar PV", "Battery Storage", ...]
  payoutAppointment  Decimal  @db.Decimal(10, 2) @default(50)
  payoutJob          Decimal  @db.Decimal(10, 2) @default(250)
  currencySymbol     String   @default("£")

  // Subscription / status
  status             CompanyStatus @default(TRIAL)
  isComped           Boolean       @default(false) // never billed (e.g. AMP)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?

  // Stripe
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  referrals Referral[]
  templates MessageTemplate[]

  @@index([status])
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  hashedPassword String
  role           Role    @default(PARTNER)

  // SUPERADMIN has no company. COMPANY_ADMIN and PARTNER do.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Profile (used by COMPANY_ADMIN and PARTNER)
  fullName     String?
  phone        String?
  businessName String?

  // Bank details for partner payouts (PARTNER only). Captured in dashboard
  // settings rather than at signup so it doesn't slow the signup flow.
  // Stored in plain text — fine for sort code / account number under UK
  // data protection rules; do not add full debit card numbers here.
  bankAccountName   String?
  bankSortCode      String?
  bankAccountNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals      Referral[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]

  @@index([companyId])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Single-use tokens for "forgot password" flow.
// The DB stores a SHA-256 hash of the token, never the raw value; the raw
// token is only ever in the link emailed to the user. Tokens expire after
// 1 hour and are marked used the moment they're consumed.
model PasswordResetToken {
  id          String    @id @default(cuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Referral {
  id        String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  partnerId String
  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  customerName  String
  customerPhone String
  customerEmail String

  addressLine1 String
  addressLine2 String?
  city         String
  postcode     String

  services String[]
  notes    String?

  // GDPR / data-protection record. The partner ticks a box on the refer
  // form confirming they have the customer's permission to share their
  // details with the receiving company. customerConsentConfirmedAt is set
  // server-side at submission so we have an auditable timestamp; the
  // boolean is kept for fast filtering. Existing rows pre-dating this
  // field default to false — meaning we explicitly don't claim consent
  // we didn't capture.
  customerConsentConfirmed   Boolean   @default(false)
  customerConsentConfirmedAt DateTime?

  status ReferralStatus @default(SUBMITTED)

  appointmentBookedAt    DateTime?
  appointmentDate        DateTime?
  appointmentCompletedAt DateTime?
  jobSoldAt              DateTime?
  jobInstalledAt         DateTime?
  jobValue               Decimal?  @db.Decimal(10, 2)
  rejectedReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts       Payout[]
  statusHistory ReferralStatusEvent[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([partnerId])
}

model ReferralStatusEvent {
  id              String          @id @default(cuid())
  referralId      String
  referral        Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  fromStatus      ReferralStatus?
  toStatus        ReferralStatus
  changedBy       String?
  note            String?
  createdAt       DateTime        @default(now())

  @@index([referralId])
}

model Payout {
  id         String       @id @default(cuid())
  referralId String
  referral   Referral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  type       PayoutType
  amount     Decimal      @db.Decimal(10, 2)
  status     PayoutStatus @default(PENDING)
  paidAt     DateTime?
  paidBy     String?
  paymentRef String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralId])
  @@index([status])
}

model MessageTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel   Channel
  title     String
  subject   String?
  body      String  @db.Text
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, channel, active, sortOrder])
}
