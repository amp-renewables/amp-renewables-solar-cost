# --- Database ---
# Postgres connection string. For local dev you can use the docker-compose
# bundled in this repo: `docker compose up -d` then use the URL below.
DATABASE_URL="postgresql://traderefer:traderefer@localhost:5432/traderefer?schema=public"

# --- Auth ---
# 32+ char random string. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string-please"

# --- Branding (white-label) ---
# Change these per licensee. All optional — sensible defaults are baked in for
# AMP Renewables.
BRAND_PRODUCT_NAME="TradeRefer"
BRAND_COMPANY_NAME="AMP Renewables"
BRAND_DOMAIN="amprenewables.co.uk"
BRAND_SUPPORT_EMAIL="partners@amprenewables.co.uk"
BRAND_SUPPORT_PHONE="0191 535 2711"
BRAND_PRIMARY_COLOR="#1a3c2a"
BRAND_ACCENT_COLOR="#52b788"
BRAND_CURRENCY="GBP"
BRAND_CURRENCY_SYMBOL="£"

# --- Payouts ---
# In whole units of the currency (e.g. £50). Change per licensee.
PAYOUT_APPOINTMENT="50"
PAYOUT_JOB="250"

# --- Services on offer (comma separated) ---
BRAND_SERVICES="Solar PV,Battery Storage,EV Charger,Heat Pump"
