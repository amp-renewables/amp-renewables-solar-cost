# --- Database ---
# Postgres connection string. For local dev you can use the docker-compose
# bundled in this repo: `docker compose up -d` then use the URL below.
DATABASE_URL="postgresql://traderefer:traderefer@localhost:5432/traderefer?schema=public"
# Optional second URL used by Prisma Migrate (direct connection, no pgbouncer).
# Only relevant when DATABASE_URL points at a pooled endpoint (e.g. Neon).
# DIRECT_DATABASE_URL="postgresql://..."

# --- Auth ---
# 32+ char random string. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string-please"

# --- Platform branding (TradeRefer itself, not per-company) ---
# All optional. Per-company branding (logo, colours, payout amounts, services)
# lives in the Company DB row and is edited at /company/settings.
PLATFORM_NAME="TradeRefer"
PLATFORM_DOMAIN="traderefer.co.uk"
PLATFORM_SUPPORT_EMAIL="support@traderefer.co.uk"
PLATFORM_PRIMARY_COLOR="#1a3c2a"
PLATFORM_ACCENT_COLOR="#52b788"

# --- Pricing (platform-level subscription price shown on marketing pages) ---
PRICING_MONTHLY="99"
PRICING_CURRENCY="GBP"
PRICING_CURRENCY_SYMBOL="£"
TRIAL_DAYS="14"

# --- Email notifications (Resend) ---
# Get a free API key from https://resend.com (3,000 emails/month free tier).
# If RESEND_API_KEY or NOTIFY_EMAIL is unset, emails are silently skipped —
# the app still works fine without email configured.
RESEND_API_KEY=""
# Where new-partner-signup and new-company-signup notifications go:
NOTIFY_EMAIL="joe@amprenewables.co.uk"
# The "From" address. Until you verify your sending domain at Resend,
# use "onboarding@resend.dev" (their sandbox sender).
# After verification: "notifications@traderefer.co.uk" or similar.
FROM_EMAIL="onboarding@resend.dev"
# Base URL used in email links back to the admin UI.
APP_URL="https://www.traderefer.co.uk"

# --- File uploads (Vercel Blob) ---
# Created automatically by Vercel when you enable Blob storage on the project.
# Logo uploads at /company/settings require these in production.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""

# --- Billing (Stripe) ---
# Required for /company/billing. Without these the page falls back to a
# read-only "billing not configured" message and the write-gate is bypassed
# (TRIAL never expires in practice, since canCompanyWrite() short-circuits
# on missing STRIPE_PRICE_ID — handy for local dev).
#
# Get keys from https://dashboard.stripe.com/test/apikeys (start in Test mode!)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# The £99/mo recurring Price ID. Created at https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID=""
# Webhook signing secret. Get this AFTER creating the webhook endpoint
# at https://dashboard.stripe.com/test/webhooks pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
